# ---------------------------------------------------------------------------
# API service configuration. Copy to .env and edit; .env is gitignored.
# Every value here has a working default, so the service runs with no .env
# at all — and with no API key and no cost.
# ---------------------------------------------------------------------------

PORT=8081
API_INSTANCE=api-local

# Where the embedding model files are cached. Mounted as a volume in Compose
# so the ~25 MB download happens once and is shared by both API replicas.
MODEL_CACHE=/app/.cache

# --- Chat provider ---------------------------------------------------------
# none      (default) retrieval only. Answers are assembled from the indexed
#           portfolio facts. Free, offline, no key, deterministic.
# ollama    a model running on your own machine. Free. Install Ollama, then
#           `ollama pull llama3.2`. From inside Docker the host is reachable
#           at host.docker.internal.
# anthropic the Claude API. Best answers. THIS ONE COSTS MONEY per request —
#           it is off by default on purpose.
CHAT_PROVIDER=none

OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-5-5
